# Description: Noto monochrome emoji variable font
# URL:         https://fonts.google.com/noto/specimen/Noto+Emoji
# Depends on:  fontconfig xorg-mkfontscale

name=ttf-font-noto-emoji-mono
version=3.002
release=1

commit=b979dba422e445492b0eb9951ac52ee0b4d648c3
source=https://raw.githubusercontent.com/google/fonts/$commit/ofl/notoemoji/NotoEmoji%5Bwght%5D.ttf

build() {
	font=$(find . -maxdepth 1 -type f -name 'NotoEmoji*ttf' -print -quit)

	test -n "$font"

	install -m 0644 -D "$font" \
		$PKG/usr/share/fonts/TTF/NotoEmoji.ttf
}
