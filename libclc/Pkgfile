# Description: Library requirements of the OpenCL C programming language
# URL:         https://libclc.llvm.org/
# Depends on:  clang spirv-llvm-translator

# Notes on dependencies:
#   clang is a strict, non-optional build and runtime requirement.
#   libclc generates LLVM IR and cannot be built or utilized with GCC.

name=libclc
version=22.1.7 # keep in sync with llvm
release=1
source=https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz

build() {
	llvmdir="llvm-project-$version.src"

	cmake -S $llvmdir/libclc -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-Wno-dev \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install
}
